<Window x:Class="DesktopClock.PointerStyleEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="指针样式编辑器" Height="720" Width="960"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinWidth="900" MinHeight="680"
        Background="#ececec" Foreground="#1d1d1f"
        FontFamily="-apple-system, SF Pro Text, PingFang SC, Microsoft YaHei UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Mac 风格色板 -->
        <Color x:Key="MacBlue">#007AFF</Color>
        <Color x:Key="MacBlueHover">#0A84FF</Color>
        <Color x:Key="MacBluePress">#0060DF</Color>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#3a3a3c" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#86868b" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="SF Mono, Menlo, Consolas, monospace" />
        </Style>

        <!-- Mac 风格 TextBox: 白底浅灰边框, 圆角 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#d2d2d7" />
            <Setter Property="Foreground" Value="#1d1d1f" />
            <Setter Property="CaretBrush" Value="#007AFF" />
            <Setter Property="SelectionBrush" Value="#007AFF" />
            <Setter Property="SelectionOpacity" Value="0.3" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#b0b0b5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac 风格 CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1d1d1f" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#ffffff" BorderBrush="#d2d2d7" BorderThickness="1.5">
                                <Path x:Name="Check" Stretch="Uniform" Margin="3"
                                      Stroke="#ffffff" StrokeThickness="2"
                                      Data="M0,5 L4,9 L11,0" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#007AFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#007AFF" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#007AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac 风格 ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#d2d2d7" />
            <Setter Property="Foreground" Value="#1d1d1f" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Mac 风格 Slider -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="#e5e5ea" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#007AFF" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="#ffffff"
                                                         Stroke="#d2d2d7" StrokeThickness="0.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="3"
                                                                          ShadowDepth="1" Opacity="0.25" Direction="270" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac 主按钮: 蓝色填充, 圆角 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0060DF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac 次要按钮: 浅灰背景, 圆角 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#e5e5ea" />
            <Setter Property="Foreground" Value="#1d1d1f" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#d1d1d6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#c7c7cc" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac 侧边按钮: 浅灰 -->
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="Foreground" Value="#1d1d1f" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="#d2d2d7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f2f2f7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e5e5ea" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac 风格 TabItem: 顶部下划线选中态 -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#86868b" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Rectangle x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                       Fill="#007AFF" Margin="0,0,0,0" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#1d1d1f" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1d1d1f" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mac 风格 ListBoxItem: 选中浅蓝 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#1d1d1f" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007AFF" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f2f2f7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主内容三列 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左列:方案列表(Mac 侧边栏卡片) ===== -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="#ffffff" CornerRadius="10"
                    BorderBrush="#e3e3e8" BorderThickness="1" Padding="12,10">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="方案列表" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Top" Text="分类筛选" FontSize="11" Foreground="#86868b" Margin="0,6,0,4" />
                    <ComboBox DockPanel.Dock="Top" x:Name="CategoryFilter" SelectedIndex="0" Margin="0,0,0,8"
                              SelectionChanged="CategoryFilter_SelectionChanged">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="简约" />
                        <ComboBoxItem Content="复古" />
                        <ComboBoxItem Content="夜光" />
                        <ComboBoxItem Content="极简" />
                        <ComboBoxItem Content="自制" />
                        <ComboBoxItem Content="商务" />
                    </ComboBox>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource SideButton}" Content="新建" Margin="0,0,4,4" Click="BtnNewSet_Click" />
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource SideButton}" Content="复制" Margin="4,0,0,4" Click="BtnDuplicateSet_Click" />
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource SideButton}" Content="删除" Margin="0,0,4,0" Click="BtnDeleteSet_Click" />
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SideButton}" Content="收藏" Margin="4,0,0,0" Click="BtnFavoriteSet_Click" />
                    </Grid>
                    <ListBox x:Name="PointerSetList" Background="Transparent" BorderThickness="0" Foreground="#1d1d1f"
                             Margin="0,0,0,4"
                             SelectionChanged="PointerSetList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★" Foreground="#FF9500" FontSize="12"
                                               Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Name}" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== 中列:TabControl 编辑参数(Mac 卡片) ===== -->
            <Border Grid.Column="1" Margin="10,0" Background="#ffffff" CornerRadius="10"
                    BorderBrush="#e3e3e8" BorderThickness="1">
                <TabControl x:Name="PointerTabs" Background="Transparent" BorderThickness="0" Padding="14,8,14,14">
                    <!-- 时针 -->
                    <TabItem Header="时针">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,10,2,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="图片路径" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HourImagePath" Margin="8,4" />
                                <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBrowseHourImage" Style="{StaticResource SecondaryButton}" Content="浏览…" Margin="6,4" Click="BrowseHourImage_Click" />

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="锚点 X" />
                                <Slider Grid.Row="1" Grid.Column="1" x:Name="HourAnchorX" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="HourAnchorX_ValueChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="HourAnchorXValue" Text="0.50" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="锚点 Y" />
                                <Slider Grid.Row="2" Grid.Column="1" x:Name="HourAnchorY" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="HourAnchorY_ValueChanged" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="HourAnchorYValue" Text="1.00" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="缩放比例" />
                                <Slider Grid.Row="3" Grid.Column="1" x:Name="HourScale" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="HourScale_ValueChanged" />
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="HourScaleValue" Text="1.00" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="染色颜色" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="HourColorBox" Margin="8,4" TextChanged="HourColorBox_TextChanged" />
                                <ContentControl Grid.Row="4" Grid.Column="2" x:Name="HourColorPreview" Width="50" Height="22" Background="#555555" Margin="6,4" Cursor="Hand" MouseDown="HourColorPreview_MouseDown" />

                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="阴影" />
                                <CheckBox Grid.Row="5" Grid.Column="1" x:Name="HourShadow" Content="启用阴影" Margin="8,8" Checked="HourShadow_Changed" Unchecked="HourShadow_Changed" />

                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="发光强度" />
                                <Slider Grid.Row="6" Grid.Column="1" x:Name="HourGlow" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="HourGlow_ValueChanged" />
                                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="HourGlowValue" Text="0.0" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="透明度" />
                                <Slider Grid.Row="7" Grid.Column="1" x:Name="HourOpacity" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="HourOpacity_ValueChanged" />
                                <TextBlock Grid.Row="7" Grid.Column="2" x:Name="HourOpacityValue" Text="1.00" Style="{StaticResource ValueText}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 分针 -->
                    <TabItem Header="分针">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,10,2,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="图片路径" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinuteImagePath" Margin="8,4" />
                                <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBrowseMinuteImage" Style="{StaticResource SecondaryButton}" Content="浏览…" Margin="6,4" Click="BrowseMinuteImage_Click" />

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="锚点 X" />
                                <Slider Grid.Row="1" Grid.Column="1" x:Name="MinuteAnchorX" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="MinuteAnchorX_ValueChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="MinuteAnchorXValue" Text="0.50" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="锚点 Y" />
                                <Slider Grid.Row="2" Grid.Column="1" x:Name="MinuteAnchorY" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="MinuteAnchorY_ValueChanged" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="MinuteAnchorYValue" Text="1.00" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="缩放比例" />
                                <Slider Grid.Row="3" Grid.Column="1" x:Name="MinuteScale" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="MinuteScale_ValueChanged" />
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="MinuteScaleValue" Text="1.00" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="染色颜色" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="MinuteColorBox" Margin="8,4" TextChanged="MinuteColorBox_TextChanged" />
                                <ContentControl Grid.Row="4" Grid.Column="2" x:Name="MinuteColorPreview" Width="50" Height="22" Background="#555555" Margin="6,4" Cursor="Hand" MouseDown="MinuteColorPreview_MouseDown" />

                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="阴影" />
                                <CheckBox Grid.Row="5" Grid.Column="1" x:Name="MinuteShadow" Content="启用阴影" Margin="8,8" Checked="MinuteShadow_Changed" Unchecked="MinuteShadow_Changed" />

                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="发光强度" />
                                <Slider Grid.Row="6" Grid.Column="1" x:Name="MinuteGlow" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="MinuteGlow_ValueChanged" />
                                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="MinuteGlowValue" Text="0.0" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="透明度" />
                                <Slider Grid.Row="7" Grid.Column="1" x:Name="MinuteOpacity" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="MinuteOpacity_ValueChanged" />
                                <TextBlock Grid.Row="7" Grid.Column="2" x:Name="MinuteOpacityValue" Text="1.00" Style="{StaticResource ValueText}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 秒针 -->
                    <TabItem Header="秒针">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,10,2,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="图片路径" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SecondImagePath" Margin="8,4" />
                                <Button Grid.Row="0" Grid.Column="2" x:Name="BtnBrowseSecondImage" Style="{StaticResource SecondaryButton}" Content="浏览…" Margin="6,4" Click="BrowseSecondImage_Click" />

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="锚点 X" />
                                <Slider Grid.Row="1" Grid.Column="1" x:Name="SecondAnchorX" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="SecondAnchorX_ValueChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SecondAnchorXValue" Text="0.50" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="锚点 Y" />
                                <Slider Grid.Row="2" Grid.Column="1" x:Name="SecondAnchorY" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="SecondAnchorY_ValueChanged" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SecondAnchorYValue" Text="1.00" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="缩放比例" />
                                <Slider Grid.Row="3" Grid.Column="1" x:Name="SecondScale" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="SecondScale_ValueChanged" />
                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SecondScaleValue" Text="1.00" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="染色颜色" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SecondColorBox" Margin="8,4" TextChanged="SecondColorBox_TextChanged" />
                                <ContentControl Grid.Row="4" Grid.Column="2" x:Name="SecondColorPreview" Width="50" Height="22" Background="#555555" Margin="6,4" Cursor="Hand" MouseDown="SecondColorPreview_MouseDown" />

                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="阴影" />
                                <CheckBox Grid.Row="5" Grid.Column="1" x:Name="SecondShadow" Content="启用阴影" Margin="8,8" Checked="SecondShadow_Changed" Unchecked="SecondShadow_Changed" />

                                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="发光强度" />
                                <Slider Grid.Row="6" Grid.Column="1" x:Name="SecondGlow" Minimum="0" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="SecondGlow_ValueChanged" />
                                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="SecondGlowValue" Text="0.0" Style="{StaticResource ValueText}" />

                                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="透明度" />
                                <Slider Grid.Row="7" Grid.Column="1" x:Name="SecondOpacity" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="8,12" ValueChanged="SecondOpacity_ValueChanged" />
                                <TextBlock Grid.Row="7" Grid.Column="2" x:Name="SecondOpacityValue" Text="1.00" Style="{StaticResource ValueText}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ===== 右列:预览区 + 方案元信息(Mac 卡片) ===== -->
            <Border Grid.Column="2" Margin="10,0,0,0" Background="#ffffff" CornerRadius="10"
                    BorderBrush="#e3e3e8" BorderThickness="1" Padding="14,12">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="实时预览" Style="{StaticResource SectionTitle}" />

                    <Border DockPanel.Dock="Top" BorderBrush="#e3e3e8" BorderThickness="1" CornerRadius="10"
                            Background="#fafafa" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Grid Width="240" Height="240">
                            <Ellipse Stroke="#d2d2d7" StrokeThickness="1" Fill="#ffffff" />
                            <Path Stroke="#c7c7cc" StrokeThickness="1" Data="M120,6 L120,14 M120,226 L120,234 M6,120 L14,120 M226,120 L234,120" />
                            <Canvas x:Name="PreviewCanvas" Width="240" Height="240" Background="Transparent" />
                            <Ellipse Width="6" Height="6" Fill="#86868b" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="方案名称" FontSize="11" Foreground="#86868b" Margin="0,4,0,4" />
                    <TextBox DockPanel.Dock="Top" x:Name="SetNameBox" Margin="0,0,0,8" TextChanged="SetNameBox_TextChanged" />

                    <TextBlock DockPanel.Dock="Top" Text="分类" FontSize="11" Foreground="#86868b" Margin="0,2,0,4" />
                    <ComboBox DockPanel.Dock="Top" x:Name="SetCategoryBox" IsEditable="True" Margin="0,0,0,8"
                              TextBoxBase.TextChanged="SetCategoryBox_TextChanged">
                        <ComboBoxItem Content="简约" />
                        <ComboBoxItem Content="复古" />
                        <ComboBoxItem Content="夜光" />
                        <ComboBoxItem Content="极简" />
                        <ComboBoxItem Content="自制" />
                        <ComboBoxItem Content="商务" />
                    </ComboBox>

                    <TextBlock DockPanel.Dock="Top" Text="备注" FontSize="11" Foreground="#86868b" Margin="0,2,0,4" />
                    <TextBox DockPanel.Dock="Top" x:Name="SetNoteBox" Margin="0,0,0,0" Height="70"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" TextChanged="SetNoteBox_TextChanged" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== 底部按钮 ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="关闭" Margin="0,0,8,0" Click="BtnClose_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="另存为新方案" Margin="0,0,8,0" Click="BtnSaveAsNew_Click" />
            <Button Style="{StaticResource PrimaryButton}" Content="应用" Click="BtnApply_Click" />
        </StackPanel>
    </Grid>
</Window>
