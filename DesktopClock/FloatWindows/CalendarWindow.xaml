<core:BaseFloatWindow x:Class="DesktopClock.FloatWindows.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DesktopClock.Core"
        Title="CalendarWindow" Height="80" Width="280">
    <Grid Margin="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="DateText"
                       FontFamily="Microsoft YaHei UI" FontSize="16" Foreground="#FF00FF66"
                       HorizontalAlignment="Center" Text="" />
            <TextBlock x:Name="LunarText"
                       FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#FFCCCCCC"
                       HorizontalAlignment="Center" Margin="0,2,0,0" Text=""
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</core:BaseFloatWindow>
