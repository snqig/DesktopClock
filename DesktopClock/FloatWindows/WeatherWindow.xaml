<core:BaseFloatWindow x:Class="DesktopClock.FloatWindows.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DesktopClock.Core"
        Title="WeatherWindow" Height="100" Width="240">
    <Grid Margin="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="MainText"
                       FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#FFD3D3D3"
                       HorizontalAlignment="Center" Text="天气加载中..." />
            <TextBlock x:Name="DetailText"
                       FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#FFAAAAAA"
                       HorizontalAlignment="Center" Margin="0,2,0,0" Text="" />
        </StackPanel>
    </Grid>
</core:BaseFloatWindow>
