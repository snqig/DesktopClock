<core:BaseFloatWindow x:Class="DesktopClock.FloatWindows.HabitCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DesktopClock.Core"
        Title="HabitCheckWindow" Height="200" Width="220">
    <Grid Margin="8">
        <StackPanel x:Name="MainPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#FFAAAAAA"
                       HorizontalAlignment="Center" Margin="0,0,0,4" Text="习惯打卡" />
            <StackPanel x:Name="HabitsPanel" Orientation="Vertical" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</core:BaseFloatWindow>
