<core:BaseFloatWindow x:Class="DesktopClock.FloatWindows.PomodoroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DesktopClock.Core"
        Title="PomodoroWindow" Height="90" Width="180">
    <Grid Margin="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PhaseText"
                       FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#FFAAAAAA"
                       HorizontalAlignment="Center" Margin="0,0,0,2" Text="🍅 番茄钟" />
            <TextBlock x:Name="TimeText"
                       FontFamily="Consolas" FontSize="20" Foreground="#FF66BB6A"
                       HorizontalAlignment="Center" Text="25:00" />
        </StackPanel>
    </Grid>
</core:BaseFloatWindow>
