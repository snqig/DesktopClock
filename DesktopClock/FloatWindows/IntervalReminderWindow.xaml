<core:BaseFloatWindow x:Class="DesktopClock.FloatWindows.IntervalReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DesktopClock.Core"
        Title="IntervalReminderWindow" Height="80" Width="200">
    <Grid Margin="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#FFAAAAAA"
                       HorizontalAlignment="Center" Margin="0,0,0,2" Text="健康提醒" />
            <TextBlock x:Name="CountdownText"
                       FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#FFD1D1D6"
                       HorizontalAlignment="Center" Text="" />
        </StackPanel>
    </Grid>
</core:BaseFloatWindow>
