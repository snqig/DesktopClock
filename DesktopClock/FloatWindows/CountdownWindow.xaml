<core:BaseFloatWindow x:Class="DesktopClock.FloatWindows.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DesktopClock.Core"
        Title="CountdownWindow" Height="100" Width="260">
    <Grid Margin="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#FFAAAAAA"
                       HorizontalAlignment="Center" Margin="0,0,0,2" Text="倒计时" />
            <TextBlock x:Name="CountdownText"
                       FontFamily="Consolas" FontSize="20" Foreground="#FFFF6600"
                       HorizontalAlignment="Center" Text="0 天 00:00:00">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="TextShadow" ShadowDepth="0" BlurRadius="0"
                                      Color="Black" Opacity="0" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</core:BaseFloatWindow>
