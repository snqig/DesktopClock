<core:BaseFloatWindow x:Class="DesktopClock.FloatWindows.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DesktopClock.Core"
        Title="ClockWindow" Height="120" Width="320">
    <Grid Margin="10">
        <TextBlock x:Name="TimeText"
                   FontFamily="Consolas" FontSize="56" Foreground="#FF00FF66"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="00:00:00">
            <TextBlock.Effect>
                <DropShadowEffect x:Name="TextShadow" ShadowDepth="0" BlurRadius="0"
                                  Color="Black" Opacity="0" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</core:BaseFloatWindow>
