<UserControl x:Class="DesktopClock.Skins.RibbonClockSkin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" Height="400">
    <Grid>
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="RibbonCanvas" Width="400" Height="400">
                <!-- Ribbons will be generated in code-behind -->
                <Ellipse x:Name="CenterGlow" Width="120" Height="120" Canvas.Left="140" Canvas.Top="140"
                         Fill="#22FFFFFF" />
                <TextBlock x:Name="TimeText" Canvas.Left="0" Canvas.Top="170" Width="400"
                           TextAlignment="Center" FontSize="48" FontWeight="Light"
                           Foreground="#E0FFFFFF" FontFamily="Segoe UI, Microsoft YaHei" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
