<UserControl x:Class="DesktopClock.Skins.AnalogClockSkin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 使用 Viewbox 保证窗口缩放矢量元素不失真 -->
    <Viewbox Stretch="Uniform">
        <Grid Width="400" Height="400">
            <!-- 图片底图层(默认动态生成透明 PNG) -->
            <Image x:Name="DialImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- 矢量指针与刻度层 -->
            <Canvas x:Name="VectorLayer" Width="400" Height="400" Background="Transparent">
                <!-- 60 个刻度(可选) -->
                <Canvas x:Name="TicksCanvas" />

                <!-- 时针 -->
                <Line x:Name="HourHand" X1="200" Y1="200" X2="200" Y2="130"
                      Stroke="Black" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="HourRotate" CenterX="200" CenterY="200" Angle="0" />
                    </Line.RenderTransform>
                </Line>

                <!-- 分针 -->
                <Line x:Name="MinuteHand" X1="200" Y1="200" X2="200" Y2="90"
                      Stroke="Black" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="MinuteRotate" CenterX="200" CenterY="200" Angle="0" />
                    </Line.RenderTransform>
                </Line>

                <!-- 秒针 -->
                <Line x:Name="SecondHand" X1="200" Y1="230" X2="200" Y2="70"
                      Stroke="Red" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <RotateTransform x:Name="SecondRotate" CenterX="200" CenterY="200" Angle="0" />
                    </Line.RenderTransform>
                </Line>

                <!-- 中心装饰圆点 -->
                <Ellipse x:Name="CenterDot" Width="14" Height="14" Fill="Black"
                         Canvas.Left="193" Canvas.Top="193" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
