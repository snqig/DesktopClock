<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 简体中文 (zh) 默认语言 -->

    <!-- 主窗口托盘菜单 -->
    <sys:String x:Key="Tray_Settings">设置...</sys:String>
    <sys:String x:Key="Tray_EditLayout">编辑布局模式</sys:String>
    <sys:String x:Key="Tray_SwitchSkin">切换表盘</sys:String>
    <sys:String x:Key="Tray_Show">显示</sys:String>
    <sys:String x:Key="Tray_Hide">隐藏</sys:String>
    <sys:String x:Key="Tray_Exit">退出</sys:String>

    <!-- 设置窗口标题与分组 -->
    <sys:String x:Key="Settings_Title">桌面时钟 设置</sys:String>
    <sys:String x:Key="Settings_Tab_Display">显示</sys:String>
    <sys:String x:Key="Settings_Tab_Layout">布局</sys:String>
    <sys:String x:Key="Settings_Tab_Background">背景</sys:String>
    <sys:String x:Key="Settings_Tab_Reminder">提醒</sys:String>
    <sys:String x:Key="Settings_Tab_System">系统</sys:String>
    <sys:String x:Key="Settings_Tab_About">关于</sys:String>

    <!-- 显示模式名称 -->
    <sys:String x:Key="Mode_digital">数字时钟</sys:String>
    <sys:String x:Key="Mode_flip">翻转时钟</sys:String>
    <sys:String x:Key="Mode_word">文字时钟</sys:String>
    <sys:String x:Key="Mode_binary">二进制时钟</sys:String>
    <sys:String x:Key="Mode_minimal">极简时钟</sys:String>
    <sys:String x:Key="Mode_progress">模拟时钟</sys:String>
    <sys:String x:Key="Mode_analog_premium">超精美模拟时钟</sys:String>
    <sys:String x:Key="Mode_mechanical">机械时钟</sys:String>
    <sys:String x:Key="Mode_analog_skin">指针表盘(自定义)</sys:String>
    <sys:String x:Key="Mode_ribbon">缎带表盘</sys:String>
    <sys:String x:Key="Mode_dual_analog">双时区表盘</sys:String>

    <!-- 通用控件 -->
    <sys:String x:Key="Common_OK">确定</sys:String>
    <sys:String x:Key="Common_Cancel">取消</sys:String>
    <sys:String x:Key="Common_Apply">应用</sys:String>
    <sys:String x:Key="Common_Save">保存</sys:String>
    <sys:String x:Key="Common_Add">添加</sys:String>
    <sys:String x:Key="Common_Edit">编辑</sys:String>
    <sys:String x:Key="Common_Delete">删除</sys:String>

    <!-- 组件名称 -->
    <sys:String x:Key="Comp_weather">天气</sys:String>
    <sys:String x:Key="Comp_date">日期</sys:String>
    <sys:String x:Key="Comp_lunar">农历</sys:String>
    <sys:String x:Key="Comp_world_clock">世界时钟</sys:String>
    <sys:String x:Key="Comp_sys_mon">系统监控</sys:String>
    <sys:String x:Key="Comp_countdown">倒计时</sys:String>
    <sys:String x:Key="Comp_scrolling_todo">待办</sys:String>
    <sys:String x:Key="Comp_media_info">音乐信息</sys:String>

    <!-- 天气状态 -->
    <sys:String x:Key="Weather_Loading">天气加载中...</sys:String>
    <sys:String x:Key="Weather_Failed">天气获取失败</sys:String>
    <sys:String x:Key="Weather_Cached">(缓存)</sys:String>
    <sys:String x:Key="Weather_Sunrise">日出</sys:String>
    <sys:String x:Key="Weather_Sunset">日落</sys:String>
</ResourceDictionary>
