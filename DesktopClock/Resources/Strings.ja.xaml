    <sys:String x:Key="Mode_analog_premium">プレミアムアナログ</sys:String>
    <sys:String x:Key="Mode_mechanical">機械式</sys:String>
    <sys:String x:Key="Mode_analog_skin">カスタム文字盤</sys:String>
    <sys:String x:Key="Mode_ribbon">リボン</sys:String>
    <sys:String x:Key="Mode_dual_analog">デュアルタイムゾーン</sys:String>

    <!-- 共通 -->
    <sys:String x:Key="Common_OK">OK</sys:String>
    <sys:String x:Key="Common_Cancel">キャンセル</sys:String>
    <sys:String x:Key="Common_Apply">適用</sys:String>
    <sys:String x:Key="Common_Save">保存</sys:String>
    <sys:String x:Key="Common_Add">追加</sys:String>
    <sys:String x:Key="Common_Edit">編集</sys:String>
    <sys:String x:Key="Common_Delete">削除</sys:String>

