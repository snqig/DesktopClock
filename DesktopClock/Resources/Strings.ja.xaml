    <sys:String x:Key="Weather_Loading">天気を読み込み中...</sys:String>
    <sys:String x:Key="Weather_Failed">天気の取得に失敗</sys:String>
    <sys:String x:Key="Weather_Cached">(キャッシュ)</sys:String>
    <sys:String x:Key="Weather_Sunrise">日の出</sys:String>
