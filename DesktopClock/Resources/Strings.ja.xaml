<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 日本語 (ja) -->

    <!-- トレイメニュー -->
    <sys:String x:Key="Tray_Settings">設定...</sys:String>
    <sys:String x:Key="Tray_EditLayout">レイアウト編集モード</sys:String>
    <sys:String x:Key="Tray_SwitchSkin">スキン切替</sys:String>
    <sys:String x:Key="Tray_Show">表示</sys:String>
    <sys:String x:Key="Tray_Hide">非表示</sys:String>
    <sys:String x:Key="Tray_Exit">終了</sys:String>

    <!-- 設定ウィンドウ -->
    <sys:String x:Key="Settings_Title">DesktopClock 設定</sys:String>
    <sys:String x:Key="Settings_Tab_Display">表示</sys:String>
    <sys:String x:Key="Settings_Tab_Layout">レイアウト</sys:String>
    <sys:String x:Key="Settings_Tab_Background">背景</sys:String>
    <sys:String x:Key="Settings_Tab_Reminder">リマインダー</sys:String>
    <sys:String x:Key="Settings_Tab_System">システム</sys:String>
    <sys:String x:Key="Settings_Tab_About">バージョン情報</sys:String>

    <!-- 表示モード -->
    <sys:String x:Key="Mode_digital">デジタル</sys:String>
    <sys:String x:Key="Mode_flip">フリップ</sys:String>
    <sys:String x:Key="Mode_word">ワード</sys:String>
    <sys:String x:Key="Mode_binary">バイナリ</sys:String>
    <sys:String x:Key="Mode_minimal">ミニマル</sys:String>
