<?xml version="1.0" encoding="utf-8"?>
<!--
  根级 Directory.Build.props
  仅为了让主项目 DesktopClock.csproj 的默认 **/*.cs glob 不纳入 tests/ 目录下的
  测试源文件(测试项目自己的 .cs 仍由测试项目编译)。
  未修改 DesktopClock.csproj 或 DesktopClock.sln。
-->
<Project>
  <PropertyGroup Condition="'$(MSBuildProjectFile)' == 'DesktopClock.csproj'">
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
