<Window x:Class="DesktopClock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时钟设置" Height="580" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" Background="#F5F5F7" Foreground="#1D1D1F"
        FontFamily="PingFang SC, Microsoft YaHei, sans-serif">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#86868B" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFF" />
            <Setter Property="BorderBrush" Value="#D2D2D7" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF" />
            <Setter Property="BorderBrush" Value="#D2D2D7" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="#FFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFF" />
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderBrush" Value="#D2D2D7" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Segmented control: 显示 / 外观 / 日期 / 功能 / 系统 -->
        <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20"
                Background="#E5E5EA" CornerRadius="8" Padding="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Border x:Name="DisplaySegment" Grid.Column="0" CornerRadius="6"
                        Background="#FFF" Padding="8,6" Cursor="Hand"
                        MouseLeftButtonDown="DisplaySegment_Click">
                    <TextBlock Text="显示" HorizontalAlignment="Center"
                               FontSize="13" FontWeight="Medium" Foreground="#1D1D1F" />
                </Border>
                <Border x:Name="AppearanceSegment" Grid.Column="1" CornerRadius="6"
                        Background="Transparent" Padding="8,6" Cursor="Hand"
                        MouseLeftButtonDown="AppearanceSegment_Click">
                    <TextBlock Text="外观" HorizontalAlignment="Center"
                               FontSize="13" FontWeight="Medium" Foreground="#86868B" />
                </Border>
                <Border x:Name="DateSegment2" Grid.Column="2" CornerRadius="6"
                        Background="Transparent" Padding="8,6" Cursor="Hand"
                        MouseLeftButtonDown="DateSegment2_Click">
                    <TextBlock Text="日期" HorizontalAlignment="Center"
                               FontSize="13" FontWeight="Medium" Foreground="#86868B" />
                </Border>
                <Border x:Name="FeaturesSegment" Grid.Column="3" CornerRadius="6"
                        Background="Transparent" Padding="8,6" Cursor="Hand"
                        MouseLeftButtonDown="FeaturesSegment_Click">
                    <TextBlock Text="功能" HorizontalAlignment="Center"
                               FontSize="13" FontWeight="Medium" Foreground="#86868B" />
                </Border>
                <Border x:Name="SystemSegment" Grid.Column="4" CornerRadius="6"
                        Background="Transparent" Padding="8,6" Cursor="Hand"
                        MouseLeftButtonDown="SystemSegment_Click">
                    <TextBlock Text="系统" HorizontalAlignment="Center"
                               FontSize="13" FontWeight="Medium" Foreground="#86868B" />
                </Border>
            </Grid>
        </Border>

        <!-- 显示 (Display) Panel -->
        <ScrollViewer x:Name="DisplayPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#FFF" CornerRadius="12" Padding="20" BorderBrush="#0000" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="显示" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间格式" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="HourFormatCombo" Grid.Column="1">
                            <ComboBoxItem Content="24小时制" Tag="true" />
                            <ComboBoxItem Content="12小时制" Tag="false" />
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="ShowSecondsCheck" Content="显示秒" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="显示模式" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DisplayModeCombo" Grid.Column="1">
                            <ComboBoxItem Content="数字" Tag="digital" />
                            <ComboBoxItem Content="翻转" Tag="flip" />
                            <ComboBoxItem Content="文字" Tag="word" />
                            <ComboBoxItem Content="二进制" Tag="binary" />
                            <ComboBoxItem Content="进度" Tag="progress" />
                            <ComboBoxItem Content="极简" Tag="minimal" />
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="WorldClockCheck" Content="世界时钟" Margin="0,0,0,8"
                              Checked="WorldClockCheck_Changed" Unchecked="WorldClockCheck_Changed" />

                    <Grid x:Name="TimeZoneRow" Margin="20,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时区" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TimeZoneCombo" Grid.Column="1" />
                    </Grid>

                    <CheckBox x:Name="ChimeCheck" Content="整点报时" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 外观 (Appearance) Panel -->
        <ScrollViewer x:Name="AppearancePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Background="#FFF" CornerRadius="12" Padding="20" BorderBrush="#0000" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="FontFamilyBox" Text="DS-Digital"
                                 TextChanged="FontFamilyBox_TextChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="FontSizeSlider" Grid.Column="1"
                                Minimum="20" Maximum="300" TickFrequency="2" IsSnapToTickEnabled="True"
                                ValueChanged="FontSizeSlider_ValueChanged"
                                Foreground="#007AFF" />
                        <TextBlock x:Name="FontSizeLabel" Grid.Column="2" Text="64"
                                   Style="{StaticResource ValueLabel}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="透明度" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Value="85"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="OpacitySlider_ValueChanged"
                                Foreground="#007AFF" />
                        <TextBlock x:Name="OpacityLabel" Grid.Column="2" Text="85%"
                                   Style="{StaticResource ValueLabel}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                        <Border x:Name="ColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="6"
                                Background="#00d4ff" BorderBrush="#D2D2D7" BorderThickness="1" Cursor="Hand"
                                MouseLeftButtonDown="ColorPreview_MouseDown" />
                        <TextBox x:Name="ColorBox" Grid.Column="2" Text="#00d4ff" Width="120" Margin="10,0,0,0"
                                 TextChanged="ColorBox_TextChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景类型" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BackgroundTypeCombo" Grid.Column="1"
                                  SelectionChanged="BackgroundTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="纯色" Tag="solid" />
                            <ComboBoxItem Content="渐变" Tag="gradient" />
                        </ComboBox>
                    </Grid>

                    <Border x:Name="GradientSettingsPanel" Margin="20,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="起始色" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="GradientStartPreview" Grid.Column="1" Width="22" Height="22" CornerRadius="4"
                                        Background="#1a1a2e" BorderBrush="#D2D2D7" BorderThickness="1" />
                                <TextBox x:Name="GradientStartBox" Grid.Column="2" Text="#1a1a2e" Width="120" Margin="8,0,0,0"
                                         TextChanged="GradientStartBox_TextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="结束色" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="GradientEndPreview" Grid.Column="1" Width="22" Height="22" CornerRadius="4"
                                        Background="#16213e" BorderBrush="#D2D2D7" BorderThickness="1" />
                                <TextBox x:Name="GradientEndBox" Grid.Column="2" Text="#16213e" Width="120" Margin="8,0,0,0"
                                         TextChanged="GradientEndBox_TextChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="角度" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="GradientAngleSlider" Grid.Column="1" Minimum="0" Maximum="360"
                                        Value="45" TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="GradientAngleSlider_ValueChanged" Foreground="#007AFF" />
                                <TextBlock x:Name="GradientAngleLabel" Grid.Column="2" Text="45"
                                           Style="{StaticResource ValueLabel}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="边框颜色" Style="{StaticResource FieldLabel}" />
                        <Border x:Name="BorderColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="6"
                                Background="#00d4ff" BorderBrush="#D2D2D7" BorderThickness="1" Cursor="Hand"
                                MouseLeftButtonDown="BorderColorPreview_MouseDown" />
                        <TextBox x:Name="BorderColorBox" Grid.Column="2" Text="#00d4ff" Width="120" Margin="10,0,0,0"
                                 TextChanged="BorderColorBox_TextChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="边框粗细" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="BorderThicknessSlider" Grid.Column="1" Minimum="0" Maximum="10"
                                Value="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="BorderThicknessSlider_ValueChanged" Foreground="#007AFF" />
                        <TextBlock x:Name="BorderThicknessLabel" Grid.Column="2" Text="1"
                                   Style="{StaticResource ValueLabel}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主题预设" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ThemePresetCombo" Grid.Column="1"
                                  SelectionChanged="ThemePresetCombo_SelectionChanged">
                            <ComboBoxItem Content="默认" Tag="default" />
                            <ComboBoxItem Content="暗黑" Tag="dark" />
                            <ComboBoxItem Content="明亮" Tag="light" />
                            <ComboBoxItem Content="绿色" Tag="green" />
                            <ComboBoxItem Content="蓝色" Tag="blue" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 日期 (Date) Panel -->
        <ScrollViewer x:Name="DatePanel2" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Background="#FFF" CornerRadius="12" Padding="20" BorderBrush="#0000" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="日期" Style="{StaticResource SectionTitle}" />

                    <CheckBox x:Name="ShowDateCheck" Content="显示日期"
                              Checked="ShowDateCheck_Changed" Unchecked="ShowDateCheck_Changed" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DateFontFamilyBox" Grid.Column="1" Text="DS-Digital"
                                 TextChanged="DateFontFamilyBox_TextChanged" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="DateFontSizeSlider" Grid.Column="1" Value="16"
                                Minimum="10" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True"
                                ValueChanged="DateFontSizeSlider_ValueChanged"
                                Foreground="#007AFF" />
                        <TextBlock x:Name="DateFontSizeLabel" Grid.Column="2" Text="16"
                                   Style="{StaticResource ValueLabel}" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                        <Border x:Name="DateColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="6"
                                Background="#00FF00" BorderBrush="#D2D2D7" BorderThickness="1" Cursor="Hand"
                                MouseLeftButtonDown="DateColorPreview_MouseDown" />
                        <TextBox x:Name="DateColorBox" Grid.Column="2" Text="#00FF00" Width="120" Margin="10,0,0,0"
                                 TextChanged="DateColorBox_TextChanged" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="位置" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DatePositionCombo" Grid.Column="1" FontSize="13"
                                  Background="#FFF" Foreground="#1D1D1F" BorderBrush="#D2D2D7">
                            <ComboBoxItem Content="顶部" Tag="top" />
                            <ComboBoxItem Content="底部" Tag="bottom" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 功能 (Features) Panel -->
        <ScrollViewer x:Name="FeaturesPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Background="#FFF" CornerRadius="12" Padding="20" BorderBrush="#0000" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="功能" Style="{StaticResource SectionTitle}" />

                    <CheckBox x:Name="ClickThroughCheck" Content="鼠标穿透模式" Margin="0,0,0,14" />

                    <CheckBox x:Name="SnapToEdgeCheck" Content="窗口贴边" Margin="0,0,0,14" />

                    <CheckBox x:Name="LockPositionCheck" Content="锁定位置" Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="快捷键隐藏" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="HotkeyBox" Text="Ctrl+H" />
                    </Grid>

                    <!-- Lunar Calendar Section -->
                    <TextBlock Text="农历" Style="{StaticResource SectionTitle}" Margin="0,20,0,14" />

                    <CheckBox x:Name="LunarCheck" Content="显示农历信息" Margin="0,0,0,10"
                              Checked="LunarCheck_Changed" Unchecked="LunarCheck_Changed" />

                    <Border x:Name="LunarSettingsPanel" Margin="20,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="SolarTermCheck" Content="显示节气" Margin="0,0,0,8"
                                      Checked="SolarTermCheck_Changed" Unchecked="SolarTermCheck_Changed" />
                            <CheckBox x:Name="ZodiacCheck" Content="显示生肖" Margin="0,0,0,10"
                                      Checked="ZodiacCheck_Changed" Unchecked="ZodiacCheck_Changed" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="LunarFontSizeSlider" Grid.Column="1" Minimum="8" Maximum="40"
                                        Value="14" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="LunarFontSizeSlider_ValueChanged"
                                        Foreground="#007AFF" />
                                <TextBlock x:Name="LunarFontSizeLabel" Grid.Column="2" Text="14"
                                           Style="{StaticResource ValueLabel}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="LunarColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="6"
                                        Background="#aaaaaa" BorderBrush="#D2D2D7" BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonDown="LunarColorPreview_MouseDown" />
                                <TextBox x:Name="LunarColorBox" Grid.Column="2" Text="#aaaaaa" Width="120" Margin="10,0,0,0"
                                         TextChanged="LunarColorBox_TextChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Reminder Section -->
                    <TextBlock Text="提醒" Style="{StaticResource SectionTitle}" Margin="0,20,0,14" />

                    <CheckBox x:Name="ReminderCheck" Content="启用定时提醒" Margin="0,0,0,10"
                              Checked="ReminderCheck_Changed" Unchecked="ReminderCheck_Changed" />

                    <Border x:Name="ReminderSettingsPanel" Margin="20,0,0,14">
                        <StackPanel>
                            <ListBox x:Name="ReminderListBox" Height="120" Margin="0,0,0,8"
                                     DisplayMemberPath="Title" SelectionMode="Single" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="添加" Style="{StaticResource SecondaryButton}" Width="60"
                                        Click="AddReminder_Click" Margin="0,0,6,0" />
                                <Button Content="编辑" Style="{StaticResource SecondaryButton}" Width="60"
                                        Click="EditReminder_Click" Margin="0,0,6,0" />
                                <Button Content="删除" Style="{StaticResource SecondaryButton}" Width="60"
                                        Click="DeleteReminder_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 系统 (System) Panel -->
        <ScrollViewer x:Name="SystemPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border Background="#FFF" CornerRadius="12" Padding="20" BorderBrush="#0000" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="系统" Style="{StaticResource SectionTitle}" />

                    <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="语言" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="LanguageCombo" Grid.Column="1">
                            <ComboBoxItem Content="中文" Tag="zh" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButton}"
                    Click="OkButton_Click" />
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
