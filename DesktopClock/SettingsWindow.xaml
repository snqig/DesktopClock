<Window x:Class="DesktopClock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时钟设置" Height="640" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" Background="#F5F5F7" Foreground="#1D1D1F"
        FontFamily="PingFang SC, Microsoft YaHei, sans-serif">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#86868B" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFF" />
            <Setter Property="BorderBrush" Value="#D2D2D7" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF" />
            <Setter Property="BorderBrush" Value="#D2D2D7" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="#FFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFF" />
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderBrush" Value="#D2D2D7" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 组件 (Components) Panel -->
        <ScrollViewer x:Name="ComponentsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#FFF" CornerRadius="12" Padding="20" BorderBrush="#0000" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="独立悬浮组件" Style="{StaticResource SectionTitle}" />

                    <!-- 全局操作 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button x:Name="ShowAllComponentsBtn" Content="全部显示" Style="{StaticResource SecondaryButton}"
                                Click="ShowAllComponentsBtn_Click" Margin="0,0,10,0" />
                        <Button x:Name="HideAllComponentsBtn" Content="全部隐藏" Style="{StaticResource SecondaryButton}"
                                Click="HideAllComponentsBtn_Click" />
                    </StackPanel>

                    <!-- 全局设置(原"系统"Tab 下沉) -->
                    <Border Background="#F5F5F7" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="全局设置" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <CheckBox x:Name="AutoStartCheck" Content="开机自启动" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="语言" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="LanguageCombo" Grid.Column="1">
                                    <ComboBoxItem Content="简体中文" Tag="zh" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="日本語" Tag="ja" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="快捷键" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HotkeyBox" Grid.Column="1" Text="Ctrl+H" />
                            </Grid>
                            <TextBlock Text="插件" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
                            <ListBox x:Name="PluginListBox" Height="100" Margin="0,0,0,6" SelectionMode="Single" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="RefreshPluginsButton" Content="刷新插件列表" Style="{StaticResource SecondaryButton}"
                                        Click="RefreshPluginsButton_Click" Margin="0,0,8,0" />
                                <Button x:Name="OpenPluginFolderButton" Content="打开插件目录" Style="{StaticResource SecondaryButton}"
                                        Click="OpenPluginFolderButton_Click" />
                                <TextBlock x:Name="PluginStatusText" VerticalAlignment="Center" FontSize="11" Foreground="#86868B" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TabControl Background="Transparent" BorderThickness="0" Padding="0">

                        <!-- Tab1: 时钟 -->
                        <TabItem Header="时钟">
                            <StackPanel Margin="8">
                                <!-- 窗口行为 -->
                                <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompClockEnabled" Content="启用时钟窗口" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompClockTopmost" Content="窗口置顶" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompClockLocked" Content="锁定位置" Margin="0,0,0,12" />

                                <!-- 时间格式与显示模式 -->
                                <TextBlock Text="时间格式" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="时间格式" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompClockHourFormat" Grid.Column="1">
                                        <ComboBoxItem Content="24小时制" Tag="true" />
                                        <ComboBoxItem Content="12小时制" Tag="false" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="CompClockShowSec" Content="显示秒" IsChecked="True" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示模式" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompClockDisplayMode" Grid.Column="1">
                                        <ComboBoxItem Content="数字" Tag="digital" />
                                        <ComboBoxItem Content="翻转" Tag="flip" />
                                        <ComboBoxItem Content="二进制" Tag="binary" />
                                        <ComboBoxItem Content="模拟时钟" Tag="progress" />
                                        <ComboBoxItem Content="超精美模拟时钟" Tag="analog_premium" />
                                        <ComboBoxItem Content="机械时钟" Tag="mechanical" />
                                        <ComboBoxItem Content="指针表盘(自定义)" Tag="analog_skin" />
                                        <ComboBoxItem Content="缎带流光" Tag="ribbon" />
                                        <ComboBoxItem Content="双时区指针" Tag="dual_analog" />
                                        <ComboBoxItem Content="赛博朋克霓虹发光指针" Tag="cyberpunk" />
                                        <ComboBoxItem Content="极简" Tag="minimal" />
                                    </ComboBox>
                                </Grid>

                                <!-- 日期显示 -->
                                <TextBlock Text="日期显示" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                                <CheckBox x:Name="CompClockShowDate" Content="在时钟下方显示日期" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="日期字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompClockDateFontCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="日期字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompClockDateFontSize" Grid.Column="1" Minimum="8" Maximum="80" Value="16"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Foreground="#007AFF" />
                                    <TextBlock x:Name="CompClockDateFontSizeLabel" Grid.Column="2" Text="16" Style="{StaticResource ValueLabel}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="日期颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompClockDateColor" Grid.Column="1" Text="#FF00FF66" />
                                </Grid>

                                <!-- 世界时钟与报时 -->
                                <TextBlock Text="扩展功能" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                                <CheckBox x:Name="CompClockWorldClock" Content="启用世界时钟(显示第二时区)" Margin="0,0,0,8" />
                                <Grid x:Name="CompClockTimeZoneRow" Margin="20,0,0,8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="时区" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompClockTimeZoneCombo" Grid.Column="1" />
                                </Grid>
                                <CheckBox x:Name="CompClockChime" Content="整点报时" Margin="0,0,0,12" />

                                <!-- 文字外观 -->
                                <TextBlock Text="文字外观" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompClockFontCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompClockFontSize" Grid.Column="1" Minimum="10" Maximum="600" Value="56" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="文字颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompClockColor" Grid.Column="1" Text="#FF00FF66" />
                                </Grid>

                                <!-- 背景 -->
                                <TextBlock Text="背景" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompClockBgOpacity" Grid.Column="1" Minimum="0" Maximum="100" Value="85"
                                            TickFrequency="5" IsSnapToTickEnabled="True" Foreground="#007AFF" />
                                    <TextBlock x:Name="CompClockBgOpacityLabel" Grid.Column="2" Text="85%" Style="{StaticResource ValueLabel}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="背景类型" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompClockBgType" Grid.Column="1">
                                        <ComboBoxItem Content="纯色" Tag="solid" />
                                        <ComboBoxItem Content="渐变" Tag="gradient" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="起始色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompClockGradStart" Grid.Column="1" Text="#1a1a2e" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="结束色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompClockGradEnd" Grid.Column="1" Text="#16213e" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="渐变角度" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompClockGradAngle" Grid.Column="1" Minimum="0" Maximum="360" Value="45"
                                            TickFrequency="5" IsSnapToTickEnabled="True" Foreground="#007AFF" />
                                    <TextBlock x:Name="CompClockGradAngleLabel" Grid.Column="2" Text="45" Style="{StaticResource ValueLabel}" />
                                </Grid>

                                <!-- 背景图片 -->
                                <TextBlock Text="背景图片" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                                <CheckBox x:Name="CompClockSkinBgEnable" Content="启用相册背景图片" Margin="0,0,0,8" />
                                <Border x:Name="CompClockSkinBgPanel" Margin="0,0,0,8" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="图片路径" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="CompClockSkinBgPath" Grid.Column="1" />
                                            <Button x:Name="CompClockSkinBgBrowse" Grid.Column="2" Content="..." Style="{StaticResource SecondaryButton}"
                                                    Click="CompClockSkinBgBrowse_Click" Margin="8,0,0,0" Padding="8,0" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="透明度" Style="{StaticResource FieldLabel}" />
                                            <Slider x:Name="CompClockSkinBgOpacity" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" Foreground="#007AFF" />
                                            <TextBlock x:Name="CompClockSkinBgOpacityLabel" Grid.Column="2" Text="100%" Style="{StaticResource ValueLabel}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="模糊" Style="{StaticResource FieldLabel}" />
                                            <Slider x:Name="CompClockSkinBgBlur" Grid.Column="1" Minimum="0" Maximum="40" Value="0"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" Foreground="#007AFF" />
                                            <TextBlock x:Name="CompClockSkinBgBlurLabel" Grid.Column="2" Text="0" Style="{StaticResource ValueLabel}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="拉伸模式" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="CompClockSkinBgStretch" Grid.Column="1">
                                                <ComboBoxItem Content="填充" Tag="UniformToFill" />
                                                <ComboBoxItem Content="等比" Tag="Uniform" />
                                                <ComboBoxItem Content="拉伸" Tag="Fill" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 边框 -->
                                <TextBlock Text="边框" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="边框颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompClockBorderColor" Grid.Column="1" Text="#00d4ff" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="边框粗细" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompClockBorderThickness" Grid.Column="1" Minimum="0" Maximum="10" Value="1"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Foreground="#007AFF" />
                                    <TextBlock x:Name="CompClockBorderThicknessLabel" Grid.Column="2" Text="1" Style="{StaticResource ValueLabel}" />
                                </Grid>

                                <!-- 主题预设 -->
                                <TextBlock Text="主题预设" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="预设" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompClockThemePreset" Grid.Column="1">
                                        <ComboBoxItem Content="默认" Tag="default" />
                                        <ComboBoxItem Content="暗黑" Tag="dark" />
                                        <ComboBoxItem Content="明亮" Tag="light" />
                                        <ComboBoxItem Content="绿色" Tag="green" />
                                        <ComboBoxItem Content="蓝色" Tag="blue" />
                                    </ComboBox>
                                </Grid>

                                <!-- 阴影 -->
                                <TextBlock Text="阴影" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompClockShadow" Content="启用阴影" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="阴影大小" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompClockShadowSize" Grid.Column="1" Minimum="0" Maximum="20" Value="4" />
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab2: 日历 -->
                        <TabItem Header="日历">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="CompCalendarEnabled" Content="启用日历窗口" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompCalendarTopmost" Content="窗口置顶" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompCalendarLocked" Content="锁定位置" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompCalendarLunar" Content="显示农历" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompCalendarFontCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompCalendarFontSize" Grid.Column="1" Minimum="8" Maximum="40" Value="16" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompCalendarColor" Grid.Column="1" Text="#FF00FF66" />
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab3: 天气 -->
                        <TabItem Header="天气">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="CompWeatherEnabled" Content="启用天气窗口" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompWeatherTopmost" Content="窗口置顶" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompWeatherLocked" Content="锁定位置" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="纬度" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompWeatherLat" Grid.Column="1" Text="39.9" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="经度" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompWeatherLon" Grid.Column="1" Text="116.4" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompWeatherFontCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompWeatherFontSize" Grid.Column="1" Minimum="8" Maximum="30" Value="13" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompWeatherColor" Grid.Column="1" Text="#FFD3D3D3" />
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab4: 多事件倒计时 -->
                        <TabItem Header="倒计时">
                            <StackPanel Margin="8">
                                <!-- 窗口行为 -->
                                <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompCountdownTopmost" Content="窗口置顶" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompCountdownLocked" Content="锁定位置" Margin="0,0,0,12" />
                                <CheckBox x:Name="CountdownEnabledCheck" Content="启用倒计时" Margin="0,0,0,14"
                                          Checked="CountdownEnabledCheck_Changed" Unchecked="CountdownEnabledCheck_Changed" />

                                <!-- 目标时间 -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="目标时间" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <DatePicker x:Name="CountdownDatePicker" Grid.Column="0" SelectedDateFormat="Short"
                                                    SelectedDateChanged="CountdownDatePicker_SelectedDateChanged" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBox x:Name="CountdownHourBox" Width="42" Text="23" HorizontalContentAlignment="Center"
                                                     TextChanged="CountdownTimeBox_TextChanged" />
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#86868B" />
                                            <TextBox x:Name="CountdownMinuteBox" Width="42" Text="59" HorizontalContentAlignment="Center"
                                                     TextChanged="CountdownTimeBox_TextChanged" />
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#86868B" />
                                            <TextBox x:Name="CountdownSecondBox" Width="42" Text="59" HorizontalContentAlignment="Center"
                                                     TextChanged="CountdownTimeBox_TextChanged" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="标题" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CountdownLabelBox" Grid.Column="1" Text="倒计时"
                                             TextChanged="CountdownLabelBox_TextChanged" />
                                </Grid>
                                <CheckBox x:Name="CountdownShowTitleCheck" Content="显示标题" Margin="0,0,0,14" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="显示模式" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CountdownDisplayModeCombo" Grid.Column="1">
                                        <ComboBoxItem Content="D 天 H:M:S" Tag="days" />
                                        <ComboBoxItem Content="仅 H:M:S" Tag="time" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="结束动作" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CountdownEndActionCombo" Grid.Column="1">
                                        <ComboBoxItem Content="无动作" Tag="none" />
                                        <ComboBoxItem Content="文字闪烁" Tag="blink" />
                                        <ComboBoxItem Content="弹窗通知" Tag="alert" />
                                        <ComboBoxItem Content="提示音" Tag="sound" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="CountdownStopAtZeroCheck" Content="归零显示 00:00:00" Margin="0,0,0,14" />

                                <!-- 文字样式 -->
                                <TextBlock Text="文字样式" Style="{StaticResource SectionTitle}" Margin="0,8,0,14" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CountdownFontFamilyCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CountdownFontSizeSlider" Grid.Column="1" Minimum="12" Maximum="120" Value="48"
                                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CountdownFontSizeSlider_ValueChanged" />
                                    <TextBlock x:Name="CountdownFontSizeLabel" Grid.Column="2" Text="48" Style="{StaticResource ValueLabel}" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="文字颜色" Style="{StaticResource FieldLabel}" />
                                    <Border x:Name="CountdownFontColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="6"
                                            Background="#FFFFFFFF" BorderBrush="#D2D2D7" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonDown="CountdownFontColorPreview_MouseDown" />
                                    <TextBox x:Name="CountdownFontColorBox" Grid.Column="2" Text="#FFFFFFFF" Margin="10,0,0,0"
                                             TextChanged="CountdownFontColorBox_TextChanged" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CountdownOpacitySlider" Grid.Column="1" Minimum="10" Maximum="100" Value="100"
                                            TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="CountdownOpacitySlider_ValueChanged" />
                                    <TextBlock x:Name="CountdownOpacityLabel" Grid.Column="2" Text="100%" Style="{StaticResource ValueLabel}" />
                                </Grid>

                                <!-- 描边 -->
                                <TextBlock Text="描边" Style="{StaticResource SectionTitle}" Margin="0,8,0,14" />
                                <CheckBox x:Name="CountdownStrokeEnabledCheck" Content="启用描边" Margin="0,0,0,14" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="描边粗细" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CountdownStrokeThicknessSlider" Grid.Column="1" Minimum="0.5" Maximum="6" Value="1.0"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="CountdownStrokeThicknessSlider_ValueChanged" />
                                    <TextBlock x:Name="CountdownStrokeThicknessLabel" Grid.Column="2" Text="1.0" Style="{StaticResource ValueLabel}" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="描边颜色" Style="{StaticResource FieldLabel}" />
                                    <Border x:Name="CountdownStrokeColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="6"
                                            Background="#FF000000" BorderBrush="#D2D2D7" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonDown="CountdownStrokeColorPreview_MouseDown" />
                                    <TextBox x:Name="CountdownStrokeColorBox" Grid.Column="2" Text="#FF000000" Margin="10,0,0,0"
                                             TextChanged="CountdownStrokeColorBox_TextChanged" />
                                </Grid>

                                <!-- 阴影 -->
                                <TextBlock Text="阴影" Style="{StaticResource SectionTitle}" Margin="0,8,0,14" />
                                <CheckBox x:Name="CountdownShadowEnabledCheck" Content="启用阴影" Margin="0,0,0,14" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="阴影大小" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CountdownShadowSizeSlider" Grid.Column="1" Minimum="0" Maximum="20" Value="4"
                                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CountdownShadowSizeSlider_ValueChanged" />
                                    <TextBlock x:Name="CountdownShadowSizeLabel" Grid.Column="2" Text="4" Style="{StaticResource ValueLabel}" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="阴影颜色" Style="{StaticResource FieldLabel}" />
                                    <Border x:Name="CountdownShadowColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="6"
                                            Background="#FF000000" BorderBrush="#D2D2D7" BorderThickness="1" Cursor="Hand"
                                            MouseLeftButtonDown="CountdownShadowColorPreview_MouseDown" />
                                    <TextBox x:Name="CountdownShadowColorBox" Grid.Column="2" Text="#FF000000" Margin="10,0,0,0"
                                             TextChanged="CountdownShadowColorBox_TextChanged" />
                                </Grid>

                                <!-- 多任务倒计时列表 -->
                                <TextBlock Text="多任务倒计时列表" Style="{StaticResource SectionTitle}" Margin="0,8,0,14" />
                                <ItemsControl x:Name="CountdownTasksListBox" Height="240" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="CountdownTaskAddButton" Content="新增任务" Style="{StaticResource SecondaryButton}"
                                            Click="CountdownTaskAddButton_Click" Margin="0,0,10,0" />
                                    <Grid Width="140" Margin="0,0,10,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="轮播间隔(秒)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                        <TextBox x:Name="CountdownRotationSecBox" Grid.Column="1" Text="10" Width="50" />
                                    </Grid>
                                    <CheckBox x:Name="CountdownTasksEnabledCheck" Content="启用多任务轮播(覆盖单任务)" Margin="0,5,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab5: 间隔提醒 -->
                        <TabItem Header="提醒">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="CompReminderEnabled" Content="启用提醒窗口" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompReminderTopmost" Content="窗口置顶" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompReminderLocked" Content="锁定位置" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="工作开始" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompReminderWorkStart" Grid.Column="1" Text="9" Width="40" HorizontalAlignment="Left" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="工作结束" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompReminderWorkEnd" Grid.Column="1" Text="18" Width="40" HorizontalAlignment="Left" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompReminderFontCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompReminderFontSize" Grid.Column="1" Minimum="8" Maximum="30" Value="14" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompReminderColor" Grid.Column="1" Text="#FFD1D1D6" />
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab6: 番茄钟 -->
                        <TabItem Header="番茄钟">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="CompPomodoroEnabled" Content="启用番茄钟窗口" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompPomodoroTopmost" Content="窗口置顶" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompPomodoroLocked" Content="锁定位置" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="专注(分)" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompPomodoroFocus" Grid.Column="1" Minimum="10" Maximum="60" Value="25" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="短休(分)" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompPomodoroShort" Grid.Column="1" Minimum="1" Maximum="15" Value="5" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="长休(分)" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompPomodoroLong" Grid.Column="1" Minimum="5" Maximum="30" Value="15" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="长休间隔" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompPomodoroInterval" Grid.Column="1" Minimum="2" Maximum="8" Value="4" />
                                </Grid>
                                <CheckBox x:Name="CompPomodoroAutoStart" Content="自动开始下一阶段" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompPomodoroFontCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompPomodoroFontSize" Grid.Column="1" Minimum="8" Maximum="40" Value="20" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompPomodoroColor" Grid.Column="1" Text="#FF66BB6A" />
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab7: 每日一言 -->
                        <TabItem Header="一言">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="CompDailyEnabled" Content="启用每日一言窗口" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompDailyTopmost" Content="窗口置顶" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompDailyLocked" Content="锁定位置" Margin="0,0,0,12" />
                                <CheckBox x:Name="CompDailyApi" Content="启用在线API" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="API地址" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompDailyApiUrl" Grid.Column="1" Text="https://v1.hitokoto.cn/?c=d&amp;c=i&amp;c=k" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="滚动速度" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompDailySpeed" Grid.Column="1" Minimum="10" Maximum="100" Value="30" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompDailyFontCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompDailyFontSize" Grid.Column="1" Minimum="8" Maximum="30" Value="12" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompDailyColor" Grid.Column="1" Text="#FF87CEFA" />
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab8: 习惯打卡 -->
                        <TabItem Header="打卡">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="CompHabitEnabled" Content="启用习惯打卡窗口" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompHabitTopmost" Content="窗口置顶" Margin="0,0,0,8" />
                                <CheckBox x:Name="CompHabitLocked" Content="锁定位置" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字体" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CompHabitFontCombo" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                                    <Slider x:Name="CompHabitFontSize" Grid.Column="1" Minimum="8" Maximum="30" Value="11" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="颜色" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CompHabitColor" Grid.Column="1" Text="#FFAAAAAA" />
                                </Grid>
                            </StackPanel>
                        </TabItem>

                    </TabControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButton}"
                    Click="OkButton_Click" />
            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
