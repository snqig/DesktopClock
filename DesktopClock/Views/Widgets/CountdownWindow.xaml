<Window x:Class="DesktopClock.Views.Widgets.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:DesktopClock.Views.Widgets"
        Title="CountdownWidget"
        Width="240" Height="120"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False">
    <Border x:Name="RootBorder" Background="Transparent" Padding="8">
        <widgets:CountdownWidget x:Name="Widget" />
    </Border>
</Window>
