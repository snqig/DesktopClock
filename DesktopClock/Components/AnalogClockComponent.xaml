<UserControl x:Class="DesktopClock.Components.AnalogClockComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="320">
    <Canvas x:Name="RootCanvas" Width="320" Height="320">
        <!-- 外圈旋转光晕(用渐变椭圆模拟 conic-gradient) -->
        <Ellipse x:Name="HaloRing" Width="332" Height="332" Canvas.Left="-6" Canvas.Top="-6" Opacity="0.25">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#f0c27f" Offset="0.0"/>
                    <GradientStop Color="#fc5c7d" Offset="0.33"/>
                    <GradientStop Color="#6a82fb" Offset="0.66"/>
                    <GradientStop Color="#f0c27f" Offset="1.0"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="HaloRotate" CenterX="166" CenterY="166" Angle="0"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- 主圆盘:径向渐变 -->
        <Ellipse Width="320" Height="320" Canvas.Left="0" Canvas.Top="0">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.3,0.3" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#2a2f45" Offset="0.0"/>
                    <GradientStop Color="#131724" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect x:Name="DiscGlow" BlurRadius="60" ShadowDepth="20"
                                  Color="Black" Opacity="0.8"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 内圈装饰环 -->
        <Ellipse Width="272" Height="272" Canvas.Left="24" Canvas.Top="24"
                 Stroke="#10FFFFFF" StrokeThickness="2">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 旋转轨道 1(12 个点,正向旋转) -->
        <Canvas x:Name="Orbit1" Width="320" Height="320" Canvas.Left="0" Canvas.Top="0">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="Orbit1Rotate" CenterX="160" CenterY="160" Angle="0"/>
            </Canvas.RenderTransform>
        </Canvas>

        <!-- 旋转轨道 2(4 个点,反向旋转) -->
        <Canvas x:Name="Orbit2" Width="224" Height="224" Canvas.Left="48" Canvas.Top="48">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="Orbit2Rotate" CenterX="112" CenterY="112" Angle="0"/>
            </Canvas.RenderTransform>
        </Canvas>

        <!-- 中心数字时间 -->
        <StackPanel Canvas.Left="50" Canvas.Top="105" Width="220" HorizontalAlignment="Center">
            <TextBlock x:Name="HmText" Text="00:00" FontSize="58" FontWeight="Bold"
                       HorizontalAlignment="Center" FontFamily="Segoe UI, Poppins"
                       FontStretch="Expanded" Typography.NumeralAlignment="Tabular">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#f6e9d7" Offset="0.0"/>
                        <GradientStop Color="#e2d4c0" Offset="1.0"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock x:Name="SecText" Text="00" FontSize="20" FontWeight="Light"
                       HorizontalAlignment="Center" Margin="0,-6,0,0"
                       Foreground="#99FFD796" Typography.NumeralAlignment="Tabular"/>
            <TextBlock x:Name="DateText" Text="----年--月--日" FontSize="12" FontWeight="Light"
                       HorizontalAlignment="Center" Margin="0,6,0,0"
                       Foreground="#40FFFFFF"/>
        </StackPanel>
    </Canvas>
</UserControl>
