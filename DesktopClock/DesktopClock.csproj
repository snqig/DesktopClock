<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>clock.ico</ApplicationIcon>
    <AssemblyTitle>DesktopClock</AssemblyTitle>
    <Version>1.1.0</Version>
    <Authors>DesktopClock</Authors>
    <Description>Desktop Clock Application with rich display modes and plugin system</Description>
    <Product>DesktopClock</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug' AND '$(TargetFramework)'=='net9.0-windows'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release' AND '$(TargetFramework)'=='net9.0-windows'">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Disable WinForms global implicit using, avoid conflict with WPF Application/Color/FontFamily etc types -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Package references for external dependencies -->
  <ItemGroup>
    <PackageReference Include="FontAwesome.WPF" Version="4.7.0" />
    <PackageReference Include="System.Windows.Extensions" Version="9.0.0" />
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- The .NET SDK automatically includes:
       - All .cs files as Compile items
       - All .xaml files (except App.xaml) as Page items
       - App.xaml as ApplicationDefinition
       No manual Compile/Page entries needed. -->
  <ItemGroup>
    <None Include="clock.ico" />
  </ItemGroup>

  <!-- 内置用户提供的表盘底图作为嵌入资源, LogicalName 固定为 DesktopClock.Skins.1.png -->
  <ItemGroup>
    <EmbeddedResource Include="Clock\1.png" LogicalName="DesktopClock.Skins.1.png" />
  </ItemGroup>

  <!-- 指针方案 PNG 素材作为 Resource(支持 pack URI 加载) -->
  <ItemGroup>
    <Resource Include="Assets\PointerSets\**\*.png" />
  </ItemGroup>

  <!-- Exclude build output and plugin sub-projects from compilation -->
  <ItemGroup>
    <Compile Remove="obj\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="Plugins\**" />
  </ItemGroup>

</Project>